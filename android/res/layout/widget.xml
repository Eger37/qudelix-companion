<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget. Colours: *_a resources follow the system light/dark (values-night);
     QudelixWidget swaps in *_l / *_d when the user forces a theme. Light = red & grey, dark = red & black.
     Same layout as the PC widget (windows/src/ui.rs). Responsive: the priority and volume
     rows share the free height (never below minHeight; widget_info minResizeHeight covers
     the sum) and every label sizes itself to its button (autoSize, one line). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/w_bg_a"
    android:padding="6dp">

    <!-- Header: "QDLX ⚙" / "5K v…" on the left, the 2×2 buttons on the right. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="15sp"
                    android:text="QDLX"
                    android:textColor="@color/text_a"
                    android:textStyle="bold" />
                <ImageView
                    android:id="@+id/btn_settings"
                    android:layout_width="22dp"
                    android:layout_height="match_parent"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_gear" />
            </LinearLayout>
            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeMaxTextSize="11sp"
                android:text="5K"
                android:textColor="@color/text_a" />
        </LinearLayout>

        <!-- 2×2 buttons: 🔊 ↻ / Unlink Disconnect. Labels shrink to fit when narrow.
             (Only RemoteViews-allowed classes here: a plain View → "Can't load widget".) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.7"
            android:layout_marginStart="6dp"
            android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:orientation="horizontal">
                <ImageView android:id="@+id/btn_output" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:layout_marginEnd="3dp"
                    android:background="@drawable/w_btn_a" android:padding="3dp"
                    android:scaleType="fitCenter" android:src="@drawable/ic_speaker" />
                <Button android:id="@+id/btn_refresh" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="@drawable/w_btn_a" android:padding="0dp"
                    android:text="↻" android:textColor="@color/text_a" android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:layout_marginTop="3dp" android:orientation="horizontal">
                <Button android:id="@+id/btn_phone_audio" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:layout_marginEnd="3dp"
                    android:background="@drawable/w_btn_a" android:paddingStart="3dp" android:paddingEnd="3dp"
                    android:paddingTop="0dp" android:paddingBottom="0dp"
                    android:maxLines="1" android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="12sp"
                    android:text="Unlink" android:textAllCaps="false" android:textColor="@color/text_a" />
                <Button android:id="@+id/btn_disconnect" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/w_btn_a" android:paddingStart="3dp" android:paddingEnd="3dp"
                    android:paddingTop="0dp" android:paddingBottom="0dp"
                    android:maxLines="1" android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="12sp"
                    android:text="Disconnect" android:textAllCaps="false" android:textColor="@color/text_a" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Priority and volume rows stretch with the widget (never below minHeight); their
         text grows / shrinks with the button (autoSize, one line), so it always fits. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="24dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btn_usb"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/w_btn_a"
            android:padding="4dp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeMaxTextSize="18sp"
            android:text="USB"
            android:textAllCaps="false"
            android:textColor="@color/text_a" />
        <!-- Bluetooth 1 / 2: the Bluetooth mark + the slot number (icon scales with the row). -->
        <LinearLayout
            android:id="@+id/btn_bt1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/w_btn_a"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="4dp">
            <ImageView android:id="@+id/ic_bt1" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:adjustViewBounds="true" android:scaleType="fitCenter" android:src="@drawable/ic_bluetooth" />
            <TextView android:id="@+id/lbl_bt1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="1" android:textColor="@color/text_a" android:textSize="15sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btn_bt2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/w_btn_a"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="4dp">
            <ImageView android:id="@+id/ic_bt2" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:adjustViewBounds="true" android:scaleType="fitCenter" android:src="@drawable/ic_bluetooth" />
            <TextView android:id="@+id/lbl_bt2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="2" android:textColor="@color/text_a" android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="24dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btn_vol_dn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/w_btn_a"
            android:padding="4dp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeMaxTextSize="18sp"
            android:text="−"
            android:textAllCaps="false"
            android:textColor="@color/text_a" />
        <TextView
            android:id="@+id/vol"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:gravity="center"
            android:padding="4dp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeMaxTextSize="18sp"
            android:text="— dB"
            android:textColor="@color/text_a" />
        <Button
            android:id="@+id/btn_vol_up"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/w_btn_a"
            android:padding="4dp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeMaxTextSize="18sp"
            android:text="+"
            android:textAllCaps="false"
            android:textColor="@color/text_a" />
    </LinearLayout>

    <!-- Tappable volume bar: segment i sets -60 + 5*(i+1) dB (widgets can't host a slider). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/seg0" android:layout_width="0dp" android:layout_height="14dp"
            android:layout_weight="1" android:background="@drawable/w_seg_off_a" />
        <TextView android:id="@+id/seg1" android:layout_width="0dp" android:layout_height="14dp"
            android:layout_weight="1" android:background="@drawable/w_seg_off_a" />
        <TextView android:id="@+id/seg2" android:layout_width="0dp" android:layout_height="14dp"
            android:layout_weight="1" android:background="@drawable/w_seg_off_a" />
        <TextView android:id="@+id/seg3" android:layout_width="0dp" android:layout_height="14dp"
            android:layout_weight="1" android:background="@drawable/w_seg_off_a" />
        <TextView android:id="@+id/seg4" android:layout_width="0dp" android:layout_height="14dp"
            android:layout_weight="1" android:background="@drawable/w_seg_off_a" />
        <TextView android:id="@+id/seg5" android:layout_width="0dp" android:layout_height="14dp"
            android:layout_weight="1" android:background="@drawable/w_seg_off_a" />
        <TextView android:id="@+id/seg6" android:layout_width="0dp" android:layout_height="14dp"
            android:layout_weight="1" android:background="@drawable/w_seg_off_a" />
        <TextView android:id="@+id/seg7" android:layout_width="0dp" android:layout_height="14dp"
            android:layout_weight="1" android:background="@drawable/w_seg_off_a" />
        <TextView android:id="@+id/seg8" android:layout_width="0dp" android:layout_height="14dp"
            android:layout_weight="1" android:background="@drawable/w_seg_off_a" />
        <TextView android:id="@+id/seg9" android:layout_width="0dp" android:layout_height="14dp"
            android:layout_weight="1" android:background="@drawable/w_seg_off_a" />
        <TextView android:id="@+id/seg10" android:layout_width="0dp" android:layout_height="14dp"
            android:layout_weight="1" android:background="@drawable/w_seg_off_a" />
        <TextView android:id="@+id/seg11" android:layout_width="0dp" android:layout_height="14dp"
            android:layout_weight="1" android:background="@drawable/w_seg_off_a" />
    </LinearLayout>

    <!-- Bottom line: the status while something happens, otherwise what is playing. -->
    <TextView
        android:id="@+id/playing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Playing: ?"
        android:textColor="@color/muted_a"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="11sp" />
</LinearLayout>
