<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.qudelixwidget.app">

    <!-- Silent self-update (USER_ACTION_NOT_REQUIRED) needs a recent target SDK: bump it
         about yearly (here and in build_apk.sh), else updates fall back to a confirm prompt. -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- Android 12+ Bluetooth permission (classic RFCOMM to the paired 5K) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Legacy (<= Android 11). No BLUETOOTH_ADMIN: the app never runs discovery. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />

    <!-- Foreground service (widget taps start it from the background) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Self-update over Tailscale (see Updater.java / publish_update.sh) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- required for a JobScheduler job with a network constraint (else SecurityException at schedule) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".App"
        android:label="Qudelix Widget"
        android:icon="@drawable/ic_widget"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Qudelix Widget">
            <!-- long-press the widget → Customize opens the settings -->
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Launcher entries: one per logo background (Settings → Logo background);
             exactly one is enabled at a time (Logo.java). -->
        <activity-alias
            android:name=".LogoWhite"
            android:targetActivity=".MainActivity"
            android:icon="@drawable/ic_logo_white"
            android:label="Qudelix Widget"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LogoRed"
            android:targetActivity=".MainActivity"
            android:icon="@drawable/ic_logo_red"
            android:label="Qudelix Widget"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LogoBlack"
            android:targetActivity=".MainActivity"
            android:icon="@drawable/ic_logo_black"
            android:label="Qudelix Widget"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LogoOrange"
            android:targetActivity=".MainActivity"
            android:icon="@drawable/ic_logo_orange"
            android:label="Qudelix Widget"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LogoAmber"
            android:targetActivity=".MainActivity"
            android:icon="@drawable/ic_logo_amber"
            android:label="Qudelix Widget"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LogoGreen"
            android:targetActivity=".MainActivity"
            android:icon="@drawable/ic_logo_green"
            android:label="Qudelix Widget"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LogoBlue"
            android:targetActivity=".MainActivity"
            android:icon="@drawable/ic_logo_blue"
            android:label="Qudelix Widget"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LogoPurple"
            android:targetActivity=".MainActivity"
            android:icon="@drawable/ic_logo_purple"
            android:label="Qudelix Widget"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Volume popup over the home screen (tap the dB readout on the widget). -->
        <activity
            android:name=".VolumeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=".volume"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar" />

        <receiver
            android:name=".QudelixWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- redraw (version, state) right after an install/self-update -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- Widget button taps. Not exported: only our own PendingIntents reach it. -->
        <receiver
            android:name=".TapReceiver"
            android:exported="false" />

        <service
            android:name=".RfcommService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".UpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
