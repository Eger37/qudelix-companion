# Machine-specific settings for the build/release scripts. Copy to local.env (git-ignored).
# Windows user profile as seen from WSL, and the same path in Windows form.
WIN_HOME=/mnt/c/Users/<you>
WIN_HOME_WIN='C:\Users\<you>'
# The PC's Tailscale MagicDNS name (tailscale status). Baked into YOUR tailnet builds only
# (publish_update.sh): they switch the phone's "Debug over Tailscale" on once. Public builds never
# carry it. Empty = your builds start with debug off too (set it on the phone by hand).
UPDATE_HOST=
