# Build output
windows/target/
android/build/
# Python caches
__pycache__/
*.pyc

# Machine-specific settings (paths, Tailscale host) — copy local.env.example
local.env
# APK signing key: the phone only accepts updates signed with it — never publish
*.keystore
*.jks
# Release signing key (Ed25519) and other secrets — never publish
secrets/
*.pem
# Raw Bluetooth captures contain device addresses and all traffic — keep local
captures/*.log
captures/*.cfa
# Icon reference photos / working files (large, personal).
# Only the masked, EXIF-stripped photos in refs/photos-public/ are published.
icon-modeling/*
!icon-modeling/notes-public/
!icon-modeling/refs/
icon-modeling/refs/*
!icon-modeling/refs/photos-public/

# Release artifacts (tools/release.sh)
dist/

# Local reverse-engineering toolkit (rea + Ghidra + JDK + Node) and copied Windows DLLs (~1.5 GB)
rea/
